// Cloudflare Worker: serves the Vite build (dist/) and forwards a few DNB requests (worker/index.ts).
{
  "name": "bookmood",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // Keep variables set in the Cloudflare dashboard (e.g. GOOGLE_BOOKS_KEY) when deploying.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker code; everything else is served straight from dist/.
    "run_worker_first": ["/api/*"]
  }
}
